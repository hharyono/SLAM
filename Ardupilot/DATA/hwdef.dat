#define CONFIG_HAL_BOARD_SUBTYPE HAL_BOARD_SUBTYPE_CHIBIOS_FMUV4
MCU STM32F4xx STM32F427xx

APJ_BOARD_ID 19
OSCILLATOR_HZ 24000000

STM32_ST_USE_TIMER 5
USB_STRING_MANUFACTURER "HaryonoPilot"
FLASH_SIZE_KB 2048

# ===PWM===
PD15	TIM4_CH4 TIM4   PWM(1)      GPIO(50) #M1
PD14    TIM4_CH3 TIM4   PWM(2)      GPIO(51) #M2
PD13 	TIM4_CH2 TIM4   PWM(3)      GPIO(52) #M3
PD12    TIM4_CH1 TIM4   PWM(4)      GPIO(53) #M4

PE14    TIM1_CH4 TIM1   PWM(5)      GPIO(54) #PWM5_SPRAYER_PUMP
PE13    TIM1_CH3 TIM1   PWM(6)      GPIO(55) #PWM6_SPRAYER_SPINNER
PE11    TIM1_CH2 TIM1   PWM(7)      GPIO(56) #PWM7
PE9     TIM1_CH1 TIM1   PWM(8)      GPIO(57) #PWM8

#PD0 CAN1_RX CAN1
#PD1 CAN1_TX CAN1

# ===ADC===
PA1 BAT_VOLT_SENS ADC1 SCALE(1)

# ===I2C===
I2C_ORDER I2C1 I2C2 I2C3
PB8 I2C1_SCL I2C1
PB9 I2C1_SDA I2C1

PB10 I2C2_SCL I2C2
PB11 I2C2_SDA I2C2

PA8 I2C3_SCL I2C3
PC9 I2C3_SDA I2C3

# ===UART===
# USART2 is telem1, USART3 is telem2
SERIAL_ORDER OTG1 USART1 USART2 USART3 UART7 

PB7     USART1_RX USART1 
PB6     USART1_TX USART1 

PD6     USART2_RX USART2 
PD5     USART2_TX USART2 

PD9     USART3_RX USART3
PD8     USART3_TX USART3

PE7     UART7_RX UART7 NODMA
PE8     UART7_TX UART7 NODMA

# ===STLINK===
PA13 JTMS-SWDIO SWD
PA14 JTCK-SWCLK SWD

# ===PPM===
PB0 TIM3_CH3 TIM3 RCININT PULLDOWN LOW

# ===LED===
PD10 LED_RED    OUTPUT OPENDRAIN HIGH GPIO(0) 
PD11 LED_BLUE  OUTPUT OPENDRAIN HIGH GPIO(1) 
define HAL_GPIO_A_LED_PIN 0 
define HAL_GPIO_B_LED_PIN 1 

# ===USB===
PA11 OTG_FS_DM OTG1
PA12 OTG_FS_DP OTG1
PA9 VBUS INPUT OPENDRAIN

# ===SPI===
# imu3
PA5 SPI1_SCK SPI1
PA6 SPI1_MISO SPI1
PA7 SPI1_MOSI SPI1
# FRAM
PB13 SPI2_SCK SPI2
PB14 SPI2_MISO SPI2
PB15 SPI2_MOSI SPI2
# ===SDCARD===
PC10 SPI3_SCK SPI3
PC11 SPI3_MISO SPI3
PC12 SPI3_MOSI SPI3

# ===FRAM===
PB12	FRAM_CS CS SPEED_VERYLOW
SPIDEV ramtron        SPI2 DEVID10 FRAM_CS      MODE3  8*MHZ  8*MHZ

# ===IMU===
PC5	BMI088_G_CS CS
PC4	BMI088_A_CS CS
PC2	DRDY1_BMI088_GYRO INPUT
PC3	DRDY2_BMI088_GYRO INPUT
PC0	DRDY3_BMI088_ACC INPUT
PC1	DRDY4_BMI088_ACC INPUT
SPIDEV bmi088_g       SPI1 DEVID4  BMI088_G_CS  MODE3 10*MHZ 10*MHZ
SPIDEV bmi088_a       SPI1 DEVID5  BMI088_A_CS  MODE3 10*MHZ 10*MHZ

#PE0	BMI270_CS CS
#PE1	DRDY5_BMI270 INPUT
#PE2	DRDY6_BMI270 INPUT
#SPIDEV bmi270  SPI1 DEVID6 BMI270_CS MODE3  1*MHZ  10*MHZ

#IMU BMI270      SPI:bmi270                  ROTATION_ROLL_180_YAW_90
IMU BMI088      SPI:bmi088_a SPI:bmi088_g   ROTATION_ROLL_180_YAW_90

PC13  SDCARD_CS CS
SPIDEV sdcard      SPI3 DEVID1  SDCARD_CS  MODE0 400*KHZ  25*MHZ

# ===PROB COMPASS===
define HAL_PROBE_EXTERNAL_I2C_COMPASSES

# I2C BMP388 or SPL06
#BARO BMP388 I2C:1:0x76
BARO SPL06  I2C:2:0x76

define HAL_I2C_INTERNAL_MASK 0

# ===DEFINES SETTINGS===
#define HAL_CHIBIOS_ARCH_FMUV4 1

define HAL_BOARD_LOG_DIRECTORY "/APM/LOGS"
define HAL_BOARD_TERRAIN_DIRECTORY "/APM/TERRAIN"

define HAL_STORAGE_SIZE        16384

# enable RAMTROM parameter storage
define HAL_WITH_RAMTRON 1

# enable FAT filesystem
define HAL_OS_FATFS_IO 1
# define default battery setup
define HAL_BATT_VOLT_PIN 12
define HAL_BATT_CURR_PIN 11
define HAL_BATT_VOLT_SCALE 11
define HAL_BATT_CURR_SCALE 18.2
