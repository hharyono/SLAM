#!/bin/sh
DAEMON=/root/LUCKFOX_CAM/build/rv1103/luckfox_landing
CONFIG=/etc/default/luckfox_landing
PIDFILE=/var/run/luckfox_landing.pid
LOGFILE=/tmp/luckfox_landing.log
ENABLED=1
APP_DIR=/root/LUCKFOX_CAM
CAMERA_CONFIG=$APP_DIR/Config/Camera.yaml
LANDING_CONFIG=$APP_DIR/Config/Landing.yaml
RTSP_MODE=1
[ -r "$CONFIG" ] && . "$CONFIG"

module_loaded() { grep -q "^$1 " /proc/modules 2>/dev/null; }
load_module() {
    module_name=${1%.ko}; module_name=$(echo "$module_name" | tr '-' '_')
    module_loaded "$module_name" && return 0
    [ -f "/oem/usr/ko/$1" ] || { echo "Missing /oem/usr/ko/$1"; return 1; }
    insmod "/oem/usr/ko/$1"
}
load_camera_modules() {
    load_module rk_dvbm.ko && load_module sc3336.ko &&
    load_module video_rkcif.ko && load_module video_rkisp.ko &&
    load_module phy-rockchip-csi2-dphy-hw.ko && load_module phy-rockchip-csi2-dphy.ko || return 1
    [ -w /sys/module/video_rkcif/parameters/clr_unready_dev ] && echo 1 > /sys/module/video_rkcif/parameters/clr_unready_dev
    [ -w /sys/module/video_rkisp/parameters/clr_unready_dev ] && echo 1 > /sys/module/video_rkisp/parameters/clr_unready_dev
    load_module rga3.ko && load_module mpp_vcodec.ko || return 1
    if ! module_loaded rockit; then
        insmod /oem/usr/ko/rockit.ko mcu_fw_path=/oem/usr/ko/hpmcu_wrap.bin \
            mcu_fw_addr=0xff6fe000 isp_max_h=1296 || return 1
    fi
}
running() {
    [ -r "$PIDFILE" ] || return 1
    read -r landing_pid < "$PIDFILE"
    case "$landing_pid" in ''|*[!0-9]*) return 1;; esac
    [ "$landing_pid" -gt 1 ] && kill -0 "$landing_pid" 2>/dev/null
}
start() {
    [ "$ENABLED" = 1 ] || { echo "luckfox_landing disabled"; return 0; }
    running && { echo "luckfox_landing already running (pid $landing_pid)"; return 0; }
    [ -x "$DAEMON" ] || { echo "Missing $DAEMON"; return 1; }
    load_camera_modules >> "$LOGFILE" 2>&1 || { echo "Camera initialization failed; see $LOGFILE"; return 1; }
    rm -f "$PIDFILE"
    cd "$APP_DIR" || return 1
    start-stop-daemon -S -q -b -m -p "$PIDFILE" -x "$DAEMON" -- \
        --camera "$CAMERA_CONFIG" --config "$LANDING_CONFIG" -rtsp "$RTSP_MODE" >> "$LOGFILE" 2>&1 || return 1
    sleep 2
    running && { echo "luckfox_landing running (pid $landing_pid), rtsp://0.0.0.0:8554/live"; return 0; }
    echo "luckfox_landing failed; see $LOGFILE"; return 1
}
stop() {
    if running; then
        kill -TERM "$landing_pid"
        remaining=6
        while running && [ "$remaining" -gt 0 ]; do sleep 1; remaining=$((remaining-1)); done
        running && { echo "luckfox_landing did not stop"; return 1; }
    fi
    rm -f "$PIDFILE"; echo "luckfox_landing stopped"
}
set_enabled() {
    value=$1
    if [ -f "$CONFIG" ] && grep -q '^ENABLED=' "$CONFIG"; then sed -i "s/^ENABLED=.*/ENABLED=$value/" "$CONFIG"
    else mkdir -p "$(dirname "$CONFIG")"; echo "ENABLED=$value" >> "$CONFIG"; fi
}
case "$1" in
    start) start;; stop) stop;; restart) stop && start;;
    enable) set_enabled 1 && start;;
    disable) stop && set_enabled 0 && echo "luckfox_landing disabled";;
    status) running && echo "luckfox_landing running (pid $landing_pid), rtsp://0.0.0.0:8554/live" || { echo "luckfox_landing stopped"; exit 1; };;
    *) echo "Usage: $0 {start|stop|restart|status|enable|disable}"; exit 2;;
esac
