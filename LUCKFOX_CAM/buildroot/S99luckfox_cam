#!/bin/sh
DAEMON=/usr/bin/luckfox_cam
CONFIG=/etc/default/luckfox_cam
PIDFILE=/var/run/luckfox_cam.pid
LOGFILE=/tmp/luckfox_cam.log
ENABLED=1
RTSP_PORT=8554
RTSP_PATH=/live
IQ_DIR=/etc/iqfiles
WIDTH=1280
HEIGHT=720
FPS=25
BITRATE=2500
[ -r "$CONFIG" ] && . "$CONFIG"

module_loaded() {
    grep -q "^$1 " /proc/modules 2>/dev/null
}
load_module() {
    module_name=${1%.ko}
    module_name=$(echo "$module_name" | tr '-' '_')
    module_loaded "$module_name" && return 0
    [ -f "/oem/usr/ko/$1" ] || { echo "Missing camera module /oem/usr/ko/$1"; return 1; }
    insmod "/oem/usr/ko/$1"
}
load_camera_modules() {
    # Minimal SC3336 CSI pipeline. Do not call the vendor insmod_ko.sh here:
    # it also reloads Wi-Fi and initializes unrelated NPU/audio/motor modules.
    load_module rk_dvbm.ko || return 1
    load_module sc3336.ko || return 1
    load_module video_rkcif.ko || return 1
    load_module video_rkisp.ko || return 1
    load_module phy-rockchip-csi2-dphy-hw.ko || return 1
    load_module phy-rockchip-csi2-dphy.ko || return 1
    [ -w /sys/module/video_rkcif/parameters/clr_unready_dev ] &&
        echo 1 > /sys/module/video_rkcif/parameters/clr_unready_dev
    [ -w /sys/module/video_rkisp/parameters/clr_unready_dev ] &&
        echo 1 > /sys/module/video_rkisp/parameters/clr_unready_dev
    load_module rga3.ko || return 1
    load_module mpp_vcodec.ko || return 1
    if ! module_loaded rockit; then
        [ -f /oem/usr/ko/rockit.ko ] || { echo "Missing camera module /oem/usr/ko/rockit.ko"; return 1; }
        insmod /oem/usr/ko/rockit.ko \
            mcu_fw_path=/oem/usr/ko/hpmcu_wrap.bin \
            mcu_fw_addr=0xff6fe000 isp_max_h=1296 || return 1
    fi
    return 0
}

running() {
    [ -r "$PIDFILE" ] || return 1
    read -r cam_pid < "$PIDFILE"
    case "$cam_pid" in ''|*[!0-9]*) return 1 ;; esac
    [ "$cam_pid" -gt 1 ] || return 1
    kill -0 "$cam_pid" 2>/dev/null || return 1
    [ "$(readlink "/proc/$cam_pid/exe")" = "$DAEMON" ]
}
start() {
    [ "$ENABLED" = 1 ] || { echo "luckfox_cam disabled in $CONFIG"; return 0; }
    running && { echo "luckfox_cam already running (pid $cam_pid)"; return 0; }
    [ -x "$DAEMON" ] || { echo "Missing $DAEMON"; return 1; }
    load_camera_modules >> "$LOGFILE" 2>&1 || {
        echo "Failed to initialize SC3336 camera modules; see $LOGFILE"
        return 1
    }
    rm -f "$PIDFILE"
    start-stop-daemon -S -q -b -m -p "$PIDFILE" -x "$DAEMON" -- \
        --port "$RTSP_PORT" --path "$RTSP_PATH" --iq-dir "$IQ_DIR" \
        --width "$WIDTH" --height "$HEIGHT" --fps "$FPS" --bitrate "$BITRATE" \
        >> "$LOGFILE" 2>&1 || return 1
    sleep 1
    running && { echo "luckfox_cam started on RTSP $RTSP_PORT (pid $cam_pid)"; return 0; }
    echo "luckfox_cam failed; see $LOGFILE"; return 1
}
stop() {
    if running; then
        kill -TERM "$cam_pid" || return 1
        remaining=5
        while running && [ "$remaining" -gt 0 ]; do sleep 1; remaining=$((remaining - 1)); done
        running && { echo "luckfox_cam did not stop"; return 1; }
    fi
    rm -f "$PIDFILE"; echo "luckfox_cam stopped"
}
set_enabled() {
    value=$1
    if [ -f "$CONFIG" ] && grep -q '^ENABLED=' "$CONFIG"; then
        sed -i "s/^ENABLED=.*/ENABLED=$value/" "$CONFIG"
    else
        mkdir -p "$(dirname "$CONFIG")"
        echo "ENABLED=$value" >> "$CONFIG"
    fi
}
case "$1" in
    start) start ;;
    stop) stop ;;
    restart) stop && start ;;
    enable) set_enabled 1 && start ;;
    disable) stop && set_enabled 0 && echo "luckfox_cam disabled" ;;
    status) running && echo "luckfox_cam running (pid $cam_pid), rtsp://0.0.0.0:$RTSP_PORT$RTSP_PATH" || { echo "luckfox_cam stopped"; exit 1; } ;;
    *) echo "Usage: $0 {start|stop|restart|status|enable|disable}"; exit 2 ;;
esac
